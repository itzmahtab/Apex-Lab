# Data source: "openf1" (default, real data) or "fixture" (offline synthetic demo)
DATA_SOURCE=openf1
# Public site URL used for share links / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local dev only: cache OpenF1 responses on disk so repeated runs stay within the free rate limit
OPENF1_CACHE_DIR=../../data/cache/openf1
# Optional: base URL of your self-hosted https://github.com/julesr0y/f1-livetiming-api instance (e.g. http://localhost:3001).
# Powers real-time data on /live. Without it, /live shows the most recent OpenF1 session, labelled "not live".
# LIVETIMING_API_URL=
